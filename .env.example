# Copy to .env for local overrides. All three are optional.

# Public origin of the deployed site. Used for canonical URLs, the sitemap and RSS.
SITE_URL=https://example.com

# Sub-path when the site is served from a folder (GitHub Pages project sites).
BASE_PATH=/

# Visual theme baked into the build: nova | atlas | paper | pop | fern (see /themes)
SITE_THEME=nova

# WordPress REST API base for the headless demo. Point it at your own site.
# Self-hosted: https://your-site.com/wp-json/wp/v2
# WordPress.com: https://public-api.wordpress.com/wp/v2/sites/your-site.wordpress.com
WP_API_URL=https://public-api.wordpress.com/wp/v2/sites/en.blog.wordpress.com
