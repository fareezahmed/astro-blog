---
import { url } from '../lib/url';
import ThemePicker from './ThemePicker';
import { themes, defaultTheme } from '../lib/themes';

const links = [
  { href: '/blog', label: 'Blog' },
  { href: '/tags', label: 'Tags' },
  { href: '/wordpress', label: 'Headless WP' },
  { href: '/themes', label: 'Themes' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(url(href));
---

<header class="border-b border-line bg-surface/80 backdrop-blur">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-4 sm:px-6">
    <a href={url('/')} class="flex items-center gap-2 font-semibold tracking-tight">
      <img src={url('/favicon.svg')} alt="" width="28" height="28" />
      <span>Astro Field Notes</span>
    </a>
    <nav aria-label="Primary" class="flex flex-wrap items-center gap-1 text-sm">
      {links.map(({ href, label }) => (
        <a
          href={url(href)}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'rounded-btn px-3 py-1.5 transition hover:bg-surface-muted',
            isActive(href) && 'bg-brand-soft text-brand',
          ]}
        >
          {label}
        </a>
      ))}
      <a href={url('/rss.xml')} class="rounded-btn px-3 py-1.5 hover:bg-surface-muted" title="RSS feed">
        RSS
      </a>
      <span class="ml-2 border-l border-line pl-3">
        <ThemePicker client:idle themes={themes.map(({ id, name }) => ({ id, name }))} defaultTheme={defaultTheme} />
      </span>
    </nav>
  </div>
</header>
