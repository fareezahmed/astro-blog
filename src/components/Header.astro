---
import { url } from '../lib/url';

const links = [
  { href: '/blog', label: 'Blog' },
  { href: '/tags', label: 'Tags' },
  { href: '/wordpress', label: 'Headless WP' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(url(href));
---

<header class="border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href={url('/')} class="flex items-center gap-2 font-semibold tracking-tight">
      <img src={url('/favicon.svg')} alt="" width="28" height="28" />
      <span>Astro Field Notes</span>
    </a>
    <nav aria-label="Primary" class="flex items-center gap-1 text-sm">
      {links.map(({ href, label }) => (
        <a
          href={url(href)}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'rounded-md px-3 py-1.5 transition hover:bg-slate-100 dark:hover:bg-slate-800',
            isActive(href) && 'bg-brand-50 text-brand-700 dark:bg-slate-800 dark:text-brand-400',
          ]}
        >
          {label}
        </a>
      ))}
      <a href={url('/rss.xml')} class="rounded-md px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800" title="RSS feed">
        RSS
      </a>
    </nav>
  </div>
</header>
