---
import type { Post } from '../lib/posts';
import { formatDate, readingTime } from '../lib/posts';
import { url } from '../lib/url';

interface Props {
  post: Post;
}
const { post } = Astro.props;
---

<article class="group rounded-xl border border-slate-200 p-5 transition hover:border-brand-400 hover:shadow-sm dark:border-slate-800 dark:hover:border-brand-500">
  <p class="mb-2 flex flex-wrap gap-x-3 text-xs text-slate-500 dark:text-slate-400">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span>{readingTime(post.body)} min read</span>
    {post.data.featured && <span class="font-medium text-brand-600 dark:text-brand-400">Featured</span>}
  </p>
  <h2 class="text-lg font-semibold leading-snug">
    <a href={url(`/blog/${post.id}`)} class="group-hover:text-brand-600 dark:group-hover:text-brand-400">{post.data.title}</a>
  </h2>
  <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{post.data.description}</p>
  {post.data.tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2">
      {post.data.tags.map((tag) => (
        <li>
          <a href={url(`/tags/${tag}`)} class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs hover:bg-brand-100 dark:bg-slate-800 dark:hover:bg-slate-700">#{tag}</a>
        </li>
      ))}
    </ul>
  )}
</article>
