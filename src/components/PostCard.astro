---
import type { Post } from '../lib/posts';
import { formatDate, readingTime } from '../lib/posts';
import { url } from '../lib/url';

interface Props {
  post: Post;
}
const { post } = Astro.props;
---

<article class="group rounded-card border border-line p-5 transition hover:border-brand hover:shadow-sm">
  <p class="mb-2 flex flex-wrap gap-x-3 text-xs text-ink-muted">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span>{readingTime(post.body)} min read</span>
    {post.data.featured && <span class="font-medium text-brand">Featured</span>}
  </p>
  <h2 class="text-lg font-semibold leading-snug">
    <a href={url(`/blog/${post.id}`)} class="group-hover:text-brand">{post.data.title}</a>
  </h2>
  <p class="mt-2 text-sm text-ink-soft">{post.data.description}</p>
  {post.data.tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2">
      {post.data.tags.map((tag) => (
        <li>
          <a href={url(`/tags/${tag}`)} class="rounded-full bg-surface-muted px-2.5 py-0.5 text-xs hover:bg-brand-soft">#{tag}</a>
        </li>
      ))}
    </ul>
  )}
</article>
