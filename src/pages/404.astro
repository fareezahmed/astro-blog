---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
---

<Layout title="Page not found" description="That page does not exist.">
  <div class="py-20 text-center">
    <p class="text-sm font-medium uppercase tracking-wider text-brand-600 dark:text-brand-400">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-300">Nothing lives at this address.</p>
    <a href={url('/')} class="mt-6 inline-block rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-700">Back home</a>
  </div>
</Layout>
