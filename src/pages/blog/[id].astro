---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate, getPublishedPosts, readingTime, type Post } from '../../lib/posts';
import { url } from '../../lib/url';

// One static HTML file per post. getStaticPaths runs once at build time.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
---

<Layout title={post.data.title} description={post.data.description} type="article" publishedTime={post.data.pubDate}>
  <article class="mx-auto max-w-3xl">
    <header class="mb-8">
      <p class="flex flex-wrap gap-x-3 text-sm text-slate-500 dark:text-slate-400">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <span>Updated {formatDate(post.data.updatedDate)}</span>}
        <span>{readingTime(post.body)} min read</span>
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{post.data.title}</h1>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <li><a href={url(`/tags/${tag}`)} class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs hover:bg-brand-100 dark:bg-slate-800 dark:hover:bg-slate-700">#{tag}</a></li>
          ))}
        </ul>
      )}
    </header>

    {toc.length > 2 && (
      <nav aria-label="Table of contents" class="mb-8 rounded-xl border border-slate-200 p-5 text-sm dark:border-slate-800">
        <p class="mb-2 font-semibold">In this post</p>
        <ol class="list-decimal space-y-1 pl-5">
          {toc.map((h) => <li><a href={`#${h.slug}`} class="hover:text-brand-600 dark:hover:text-brand-400">{h.text}</a></li>)}
        </ol>
      </nav>
    )}

    <div class="prose prose-slate max-w-none dark:prose-invert prose-a:text-brand-600 dark:prose-a:text-brand-400 prose-headings:scroll-mt-20">
      <Content />
    </div>

    <footer class="mt-12 grid gap-4 border-t border-slate-200 pt-6 text-sm sm:grid-cols-2 dark:border-slate-800">
      {older && (
        <a href={url(`/blog/${older.id}`)} class="rounded-lg border border-slate-200 p-4 hover:border-brand-400 dark:border-slate-800">
          <span class="block text-xs text-slate-500">← Older</span>
          <span class="font-medium">{older.data.title}</span>
        </a>
      )}
      {newer && (
        <a href={url(`/blog/${newer.id}`)} class="rounded-lg border border-slate-200 p-4 text-right hover:border-brand-400 sm:col-start-2 dark:border-slate-800">
          <span class="block text-xs text-slate-500">Newer →</span>
          <span class="font-medium">{newer.data.title}</span>
        </a>
      )}
    </footer>
  </article>
</Layout>
