---
import Layout from '../../layouts/Layout.astro';
import PostSearch from '../../components/PostSearch';
import { formatDate, getPublishedPosts } from '../../lib/posts';
import { url } from '../../lib/url';

const posts = await getPublishedPosts();

// Islands receive serializable props only. Pass plain data, not collection entries.
const searchable = posts.map((post) => ({
  id: post.id,
  url: url(`/blog/${post.id}`),
  title: post.data.title,
  description: post.data.description,
  date: formatDate(post.data.pubDate),
  tags: post.data.tags,
}));
---

<Layout title="Blog" description="All posts on Astro Field Notes, searchable by title and tag.">
  <h1 class="text-3xl font-bold">Blog</h1>
  <p class="mt-2 mb-8 text-ink-soft">
    The search box below is a React island hydrated with <code>client:load</code>. Everything else on this page is static HTML.
  </p>
  <PostSearch client:load posts={searchable} />
</Layout>
