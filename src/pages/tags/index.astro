---
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/posts';
import { url } from '../../lib/url';

const posts = await getPublishedPosts();
const tags = getTagCounts(posts);
---

<Layout title="Tags" description="Browse posts by tag.">
  <h1 class="text-3xl font-bold tracking-tight">Tags</h1>
  <ul class="mt-6 flex flex-wrap gap-3">
    {tags.map(([tag, count]) => (
      <li>
        <a href={url(`/tags/${tag}`)} class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-4 py-1.5 text-sm hover:border-brand-400 dark:border-slate-800">
          #{tag} <span class="rounded-full bg-slate-100 px-2 text-xs dark:bg-slate-800">{count}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
